#include <iostream>
#include <vector>
void heapify(std::vector<int>& arr, int heapSize, int i) {
    int largest = i;        
    int leftChild = 2 * i + 1; 
    int rightChild = 2 * i + 2; 
    if (leftChild < heapSize && arr[leftChild] > arr[largest]) {
        largest = leftChild;
    }
    if (rightChild < heapSize && arr[rightChild] > arr[largest]) {
        largest = rightChild;
    }
    if (largest != i) {
        std::swap(arr[i], arr[largest]);
        heapify(arr, heapSize, largest);
    }
}
void heapSort(std::vector<int>& arr) {
    int n = arr.size();
    for (int i = n / 2 - 1; i >= 0; --i) {
        heapify(arr, n, i);
    }
    for (int i = n - 1; i > 0; --i) {
        std::swap(arr[0], arr[i]);

        heapify(arr, i, 0);
    }
}
void printArray(const std::vector<int>& arr) {
    for (int val : arr) {
        std::cout << val << " ";
    }
    std::cout << "\n";
}

int main() {
    std::vector<int> data = {45, 12, 85, 32, 89, 4, 67, 23};

    std::cout << "Original array: ";
    printArray(data);

    heapSort(data);

    std::cout << "Sorted array:   ";
    printArray(data);

    return 0;
}
